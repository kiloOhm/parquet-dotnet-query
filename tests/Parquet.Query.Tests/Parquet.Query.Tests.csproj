<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net48</TargetFrameworks>
    <TargetFrameworks Condition="'$(UseLocalParquetProject)' == 'true'">net8.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseLocalParquetProject)' == 'true' and '$(TargetFramework)' != 'net48'">
    <ProjectReference Include="$(ParquetProjectPath)" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0' and '$(UseLocalParquetProject)' != 'true'">
    <PackageReference Include="kiloOhm.Parquet.Net" Version="$(ParquetNetVersion)" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="kiloOhm.Parquet.Net" Version="$(LegacyParquetNetVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Parquet.Query.Extensions.Pooling\Parquet.Query.Extensions.Pooling.csproj" />
    <ProjectReference Include="..\..\src\Parquet.Query.Extensions.Indexing\Parquet.Query.Extensions.Indexing.csproj" />
    <ProjectReference Include="..\..\src\Parquet.Query\Parquet.Query.csproj" />
    <ProjectReference Include="..\..\src\Parquet.Query.Extensions.Search\Parquet.Query.Extensions.Search.csproj" />
    <ProjectReference Include="..\..\src\Parquet.Query.Extensions.Writing\Parquet.Query.Extensions.Writing.csproj" />
  </ItemGroup>

</Project>
